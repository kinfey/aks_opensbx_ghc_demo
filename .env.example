AZURE_SUBSCRIPTION=<enabled-subscription-name>
AZURE_RESOURCE_GROUP=<existing-resource-group>
AZURE_LOCATION=swedencentral

RESOURCE_PREFIX=mcdkata
AKS_NAME=<new-aks-cluster-name>
ACR_NAME=<existing-acr-name>
LOG_ANALYTICS_WORKSPACE_NAME=<existing-log-analytics-workspace-name>

BACKEND_APP_NAME=<your-backend-container-app-name>
FRONTEND_APP_NAME=<your-frontend-container-app-name>
AKS_AUTHORIZED_IP_RANGES=<deployment-client-public-ip>/32

GITHUB_TOKEN=<fine-grained-token-with-copilot-requests>
MCD_MCP_TOKEN=<mcd-mcp-token>

# Optional repeatable deployment values:
# IMAGE_TAG=20260929
# OPENSANDBOX_API_KEY=<random-hex-value>
# OPENSANDBOX_SECURE_ACCESS_KEY=<random-base64-value>
